# Avarpus API — production environment for the VPS.
# Copy to /etc/avarpus/api.env, fill in the values, then:
#   sudo chown avarpus:avarpus /etc/avarpus/api.env && sudo chmod 600 /etc/avarpus/api.env
# Values for the secrets below live in the Replit workspace Secrets pane —
# copy them from there. Never commit the filled-in file.

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# ---- Database (local PostgreSQL on the VPS) ----
DATABASE_URL=postgresql://avarpus:CHANGE_ME@127.0.0.1:5432/avarpus

# ---- Sessions / CORS ----
SESSION_SECRET=
# Browser origins allowed to call the API (web app + admin panel). Comma-separated.
ALLOWED_ORIGINS=https://avarpus.com,https://www.avarpus.com,https://app.avarpus.com,https://admin.avarpus.com

# ---- Object storage: plain Google Cloud Storage bucket ----
OBJECT_STORAGE_PROVIDER=gcs
GCS_SERVICE_ACCOUNT_KEY_FILE=/etc/avarpus/gcs-service-account.json
# Same layout as on Replit, only the bucket name changes:
#   /<bucket>/.private  and  /<bucket>/public
PRIVATE_OBJECT_DIR=/avarpus-prod-objects/.private
# Storage-deleting jobs (abandoned upload sweep, Status cleanup, chat relay
# purge) run only where the database owns the bucket. Outside a Replit
# deployment they stay off unless switched on explicitly; set this to "on"
# ONLY after objects and the database have both been migrated to this host.
OBJECT_STORAGE_SWEEPS=off
PUBLIC_OBJECT_SEARCH_PATHS=/avarpus-prod-objects/public

# ---- Email (Resend, direct API) ----
RESEND_API_KEY=
MAIL_FROM=Avarpus <noreply@vmcelectronic.com>
RESEND_WEBHOOK_SECRET=

# ---- OTP / SMS ----
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
HANU_OTP_API_KEY=
SMS_BRIDGE_SHARED_SECRET=
# Dev-only bypass code; leave EMPTY in production.
AVARPUS_DEV_TEST_CODE=

# ---- Chat (Matrix / ESS) ----
MATRIX_BASE_URL=
MATRIX_SERVER_NAME=
MATRIX_APP_SERVICE_TOKEN=
MATRIX_HOMESERVER_TOKEN=
# Public callback URL the homeserver uses to reach this API:
MATRIX_APP_SERVICE_URL=https://api.avarpus.com/api/matrix/appservice

# ---- Calls (LiveKit) — leave empty if calls are not enabled ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Push notifications (Expo) ----
EXPO_ACCESS_TOKEN=

# ---- Google Drive backup (OAuth web client) ----
GOOGLE_BACKUP_CLIENT_ID=
GOOGLE_BACKUP_CLIENT_SECRET=
GOOGLE_BACKUP_REDIRECT_URI=https://api.avarpus.com/api/drive-backup/oauth/callback

# ---- Data import endpoint (only needed while importing; remove afterwards) ----
IMPORT_BUNDLE_TOKEN=
