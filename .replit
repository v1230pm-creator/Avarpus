[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ALLOWED_ORIGINS = "https://3c2b05f7-3c61-425c-9ed4-67462616b38f-00-f8q4w8aat8g9-ujyonlba.sisko.replit.dev,https://app.avarpus.com"
MAIL_FROM = "Avarpus <noreply@vmcelectronic.com>"
MATRIX_BASE_URL = "https://matrix.avarpus.com"
MATRIX_APP_SERVICE_URL = "https://api.avarpus.com/api/matrix/appservice"
GOOGLE_BACKUP_REDIRECT_URI = "https://api.avarpus.com/api/drive-backup/oauth/callback"

[userenv.production]

[objectStorage]
defaultBucketID = "replit-objstore-bdc44916-c203-4ff0-bb3d-753049591581"
