modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "shop-isolation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "customer-balances"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "registration-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stage-locks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "portal-repair-isolation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "deployment-readiness"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "public-requests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-public-requests-browser"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "official-site-public-claims"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chat-blocks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chat-reports"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-chat-reports-browser"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "push-delivery"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "brand-assets"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web-list-search"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "session-idle"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mobile run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "shop-isolation"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock node scripts/run-isolated.mjs scripts/test-shop-isolation.mjs"

[[workflows.workflow]]
name = "customer-balances"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock node scripts/run-isolated.mjs scripts/test-customer-balances.mjs"

[[workflows.workflow]]
name = "registration-gate"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock node scripts/run-isolated.mjs scripts/test-registration-gate.mjs"

[[workflows.workflow]]
name = "stage-locks"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock node scripts/run-isolated.mjs scripts/test-stage-locks.mjs"

[[workflows.workflow]]
name = "portal-repair-isolation"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock node scripts/run-isolated.mjs scripts/test-portal-repair-isolation.mjs"

[[workflows.workflow]]
name = "api-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workspace-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workspace-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run build"

[workflows.workflow.metadata]
