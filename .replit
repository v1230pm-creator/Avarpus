modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "shop-isolation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "customer-balances"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "registration-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stage-locks"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mobile run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "shop-isolation"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock sh -c 'pnpm run build && node scripts/test-shop-isolation.mjs'"

[[workflows.workflow]]
name = "customer-balances"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock sh -c 'pnpm run build && node scripts/test-customer-balances.mjs'"

[[workflows.workflow]]
name = "registration-gate"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock sh -c 'pnpm run build && node scripts/test-registration-gate.mjs'"

[[workflows.workflow]]
name = "stage-locks"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && flock /tmp/api-server-tests.lock sh -c 'pnpm run build && node scripts/test-stage-locks.mjs'"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ALLOWED_ORIGINS = "https://3c2b05f7-3c61-425c-9ed4-67462616b38f-00-f8q4w8aat8g9-ujyonlba.sisko.replit.dev,https://app.avarpus.com"
MAIL_FROM = "Avarpus <noreply@vmcelectronic.com>"
MATRIX_BASE_URL = "https://matrix.avarpus.com"
MATRIX_APP_SERVICE_URL = "https://api.avarpus.com/api/matrix/appservice"

[userenv.production]

[objectStorage]
defaultBucketID = "replit-objstore-bdc44916-c203-4ff0-bb3d-753049591581"
