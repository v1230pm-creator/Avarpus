name = "deployment-readiness"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "VITE_API_URL=https://api.avarpus.com pnpm run validate:deployment-readiness"

[[workflows.workflow]]
name = "public-requests"
