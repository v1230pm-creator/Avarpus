# Register this file in ESS/Synapse only after replacing both token placeholders
# with independent random values stored in Replit Secrets.
id: avarpus-chat
url: https://api.avarpus.com/api/matrix/appservice
as_token: <MATRIX_APP_SERVICE_TOKEN>
hs_token: <MATRIX_HOMESERVER_TOKEN>
sender_localpart: avarpus-chat
rate_limited: false
namespaces:
  users:
    - exclusive: true
      regex: '^@appuser-[a-f0-9]{32}:avarpus\.com$'
  aliases:
    - exclusive: true
      regex: '^#appchat-[a-f0-9]{40}:avarpus\.com$'
  rooms: []