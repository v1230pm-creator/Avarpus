{
  "expo": {
    "name": "Avarpus",
    "slug": "avarpus",
    "version": "1.0.6",
    "orientation": "default",
    "icon": "./assets/images/avarpus-icon-universal-square.png",
    "scheme": "vmcelectronicerp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vmcelectronicerp.app"
    },
    "android": {
      "package": "com.vmcelectronicerp.app",
      "versionCode": 16,
      "icon": "./assets/images/avarpus-icon-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/avarpus-adaptive-foreground.png",
        "backgroundColor": "#0FA9FF"
      },
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#006DA8",
      "translucent": false
    },
    "web": {
      "favicon": "./assets/images/avarpus-icon-universal-square.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "android": {
            "backgroundColor": "#006DA8",
            "drawable": {
              "icon": "./assets/android/splash-transparent.xml"
            }
          }
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#006DA8",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Avarpus to find registered contacts without uploading an app-wide directory."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Avarpus to show recent photos you choose to share in chats.",
          "savePhotosPermission": "Allow Avarpus to save chat photos you download to your gallery."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Avarpus to get your current location when you choose to share it in a chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Avarpus to record voice notes and use audio calls."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Avarpus to scan repair QR codes and use video calls."
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-sharing"
    ],
    "owner": "julian647",
    "extra": {
      "eas": {
        "projectId": "ebcf3946-9c4c-4fd5-bfc8-21e18bed3454"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
