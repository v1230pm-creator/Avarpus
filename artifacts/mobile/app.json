{
  "expo": {
    "name": "Avarpus",
    "slug": "avarpus",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/avarpus-icon.png",
    "scheme": "vmcelectronicerp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/avarpus-native-loading.png",
      "resizeMode": "cover",
      "backgroundColor": "#020817",
      "dark": {
        "image": "./assets/images/avarpus-native-loading.png",
        "backgroundColor": "#020812"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vmcelectronicerp.app"
    },
    "android": {
      "package": "com.vmcelectronicerp.app",
      "versionCode": 16,
      "icon": "./assets/images/avarpus-android-legacy-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/avarpus-adaptive-foreground.png",
        "backgroundColor": "#020817"
      },
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#040914",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#040914"
    },
    "web": {
      "favicon": "./assets/images/avarpus-favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "android": {
            "backgroundColor": "#040914",
            "drawable": {
              "icon": "./assets/android/splash-transparent.xml"
            }
          }
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Avarpus to find registered contacts without uploading an app-wide directory."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Avarpus to record voice notes and use audio calls."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Avarpus to scan repair QR codes and use video calls."
        }
      ]
    ],
    "owner": "avarpus-team",
    "extra": {
      "eas": {
        "projectId": "2faf87fd-bd32-4f83-8973-af020d1dc839"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}