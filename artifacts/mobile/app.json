{
  "expo": {
    "name": "VMC Electronic BMS",
    "slug": "vmcelectronicerp",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vmcelectronicerp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vmcelectronicerp.app"
    },
    "android": {
      "package": "com.vmcelectronicerp.app",
      "versionCode": 16,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VMC Electronic BMS to record voice notes and use audio calls."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VMC Electronic BMS to scan repair QR codes and use video calls."
        }
      ]
    ],
    "owner": "vmcelectronics-team",
    "extra": {
      "eas": {
        "projectId": "a67308ff-eda0-485d-927d-df3c548e9ecc"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}