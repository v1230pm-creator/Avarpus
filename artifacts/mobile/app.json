{
  "expo": {
    "name": "VMC Electronic BMS",
    "slug": "vmcelectronicerp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vmcelectronicerp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vmcelectronicerp.app"
    },
    "android": {
      "package": "com.vmcelectronicerp.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan repair job QR codes."
        }
      ]
    ],
    "owner": "vmcelectronics-team",
    "extra": {
      "eas": {
        "projectId": "a67308ff-eda0-485d-927d-df3c548e9ecc"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}