{
  "expo": {
    "name": "Avarpus",
    "slug": "avarpus",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/avarpus-icon.png",
    "scheme": "vmcelectronicerp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/avarpus-splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f3ec",
      "dark": {
        "image": "./assets/images/avarpus-splash-dark.png",
        "backgroundColor": "#0f1d2d"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vmcelectronicerp.app"
    },
    "android": {
      "package": "com.vmcelectronicerp.app",
      "versionCode": 16,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES", "android.permission.SEND_SMS"]
    },
    "web": {
      "favicon": "./assets/images/avarpus-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Avarpus to find registered contacts without uploading an app-wide directory."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Avarpus to record voice notes and use audio calls."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Avarpus to scan repair QR codes and use video calls."
        }
      ]
    ],
    "owner": "avarpus-team",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}