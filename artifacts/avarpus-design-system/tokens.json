{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Avarpus design tokens (DTCG). THIS FILE IS THE SINGLE SOURCE OF TRUTH. Colors, radius and fonts are extracted from the Avarpus mobile app theme (artifacts/mobile/constants/colors.ts, brand.ts) which is the brand authority; sidebar roles are derived because the phone app has no sidebar (the web app's dark navy rail informed them). Do not hand-edit src/index.css or src/generated/tokens.tsx; scripts/build-tokens.mjs regenerates them.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f4f7fb", "$description": "App canvas (mobile light.background)." },
      "foreground": { "$value": "#162236", "$description": "Ink text (mobile light.text)." },
      "border": { "$value": "#d7e1ed" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#162236" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#162236" },
      "primary": {
        "$value": "#0f62fe",
        "$description": "Avarpus action blue (mobile light.primary). Drives buttons, links, focus and the loading ring."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#eaf0f7", "$description": "Secondary surface (mobile light.secondary / backgroundSecondary)." },
      "secondaryForeground": { "$value": "#3e5068" },
      "muted": { "$value": "#eaf0f7", "$description": "Mobile light.muted equals the canvas; the web theme uses backgroundSecondary so muted blocks stay visible on the page." },
      "mutedForeground": { "$value": "#718096" },
      "accent": { "$value": "#eaf2ff", "$description": "Soft blue tint (mobile light.accent / infoLight)." },
      "accentForeground": { "$value": "#0866ff" },
      "destructive": { "$value": "#ff4d4f" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d7e1ed" },
      "ring": { "$value": "#0f62fe" },
      "chart1": { "$value": "#0866ff", "$description": "Brand blue / status received." },
      "chart2": { "$value": "#20c878", "$description": "Success green." },
      "chart3": { "$value": "#d9a441", "$description": "Brand gold." },
      "chart4": { "$value": "#8b5cf6", "$description": "Purple / status diagnosing." },
      "chart5": { "$value": "#0891b2", "$description": "Cyan / status testing." },
      "sidebar": { "$value": "#162236", "$description": "Derived: ink navy rail (no sidebar on the phone app)." },
      "sidebarForeground": { "$value": "#f1f4f8" },
      "sidebarBorder": { "$value": "#2d3644" },
      "sidebarPrimary": { "$value": "#1683ff" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#262e3a" },
      "sidebarAccentForeground": { "$value": "#f1f4f8" },
      "sidebarRing": { "$value": "#1683ff" }
    },
    "dark": {
      "background": { "$value": "#1b212b", "$description": "Soft slate canvas, deliberately not black (mobile dark.background)." },
      "foreground": { "$value": "#f1f4f8", "$description": "Low-glare off-white (mobile dark.text)." },
      "border": { "$value": "#38424f" },
      "card": { "$value": "#262e3a" },
      "cardForeground": { "$value": "#f1f4f8" },
      "popover": { "$value": "#333d4c", "$description": "Mobile dark.surfaceElevated." },
      "popoverForeground": { "$value": "#f1f4f8" },
      "primary": { "$value": "#0f62fe", "$description": "Same action blue in both modes (mobile dark.primary)." },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#2d3644" },
      "secondaryForeground": { "$value": "#b7c0ce" },
      "muted": { "$value": "#222934" },
      "mutedForeground": { "$value": "#aab4c3" },
      "accent": { "$value": "#192b4b", "$description": "rgba(15,98,254,0.15) flattened over the dark canvas." },
      "accentForeground": { "$value": "#1683ff" },
      "destructive": { "$value": "#ff4d4f" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#38424f" },
      "ring": { "$value": "#1683ff" },
      "chart1": { "$value": "#1683ff" },
      "chart2": { "$value": "#34d399" },
      "chart3": { "$value": "#f2c96b" },
      "chart4": { "$value": "#a78bfa" },
      "chart5": { "$value": "#22d3ee" },
      "sidebar": { "$value": "#151a22", "$description": "Derived: one step darker than the canvas." },
      "sidebarForeground": { "$value": "#f1f4f8" },
      "sidebarBorder": { "$value": "#2d3644" },
      "sidebarPrimary": { "$value": "#1683ff" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#262e3a" },
      "sidebarAccentForeground": { "$value": "#f1f4f8" },
      "sidebarRing": { "$value": "#1683ff" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "system-ui", "sans-serif"],
        "$description": "Inter 400/500/600/700 — loaded on the phone via @expo-google-fonts and on the web via Google Fonts."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "12px — the mobile app's default card/control radius (radiusSm 8, radiusLg 16, radiusXl 24 derive from it)."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "4px base step; mobile paddings are 8/13/17 vertical and 14/20/26 horizontal on buttons, 16 on cards."
    }
  }
}
